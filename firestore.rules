// Reguły bazy Planera (Cloud Firestore) - kopia reguł opublikowanych w konsoli Firebase
// (Firestore → Rules). To one decydują, kto co może czytać i zmieniać - niezależnie od kodu strony.
// Serwer przypomnień (scripts/send-reminders.ts) działa na koncie usługi i reguł nie potrzebuje.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Administratorzy - ta sama lista co ADMIN_EMAILS w src/lib/firebaseConfig.ts.
    function isAdmin() {
      return signedIn() && request.auth.token.email.lower() in ['fizzz.to@gmail.com'];
    }

    // Zwykły użytkownik: potwierdzony e-mail i konto zatwierdzone przez administratora.
    function isApproved() {
      return signedIn()
        && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/access/$(request.auth.uid)).data.status == 'approved';
    }

    function hasAccess() {
      return isAdmin() || isApproved();
    }

    // Prośby o dostęp: każdy widzi i zakłada tylko swoją (jako "pending"), decyduje administrator.
    // Własną prośbę można usunąć - przy usuwaniu konta. Zatwierdzony tester zmienia w niej tylko
    // listę odhaczonych zadań (testerTasks), żeby administrator widział postęp.
    match /access/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email;
      allow update: if isAdmin()
        || (isApproved()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['testerTasks'])
            && request.resource.data.testerTasks is list
            && request.resource.data.testerTasks.size() <= 20);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // Prywatne dane (plan, notatki, terminy, ustawienia, przypomnienia):
    // każdy widzi i zmienia tylko swoje. Administrator też nie ma tu dostępu.
    match /users/{uid}/{document=**} {
      allow read, write: if hasAccess() && request.auth.uid == uid;
    }

    // Wspólne materiały przedmiotów: czytają wszyscy z dostępem, zmienia i usuwa tylko autor.
    match /materials/{fileId} {
      allow read: if hasAccess();
      allow create: if hasAccess()
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.size is int
        && request.resource.data.size <= 20971520
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount <= 30
        && request.resource.data.complete == false;
      allow update: if hasAccess()
        && resource.data.uploadedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['complete']);
      allow delete: if hasAccess() && resource.data.uploadedBy == request.auth.uid;

      match /chunks/{chunkId} {
        allow read: if hasAccess();
        allow create: if hasAccess()
          && get(/databases/$(database)/documents/materials/$(fileId)).data.uploadedBy == request.auth.uid
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 921600;
        allow delete: if hasAccess()
          && get(/databases/$(database)/documents/materials/$(fileId)).data.uploadedBy == request.auth.uid;
      }
    }

    // Zgłoszenia od testerów: autor widzi i może usunąć swoje (też przy usuwaniu konta), administrator widzi wszystkie,
    // odpowiada i zmienia status. Załączniki w kawałkach, jak materiały.
    match /feedback/{id} {
      function isAuthor() {
        return signedIn() && resource.data.uid == request.auth.uid;
      }
      allow read: if isAdmin() || (hasAccess() && isAuthor());
      allow create: if hasAccess()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['uid', 'email', 'kind', 'good', 'bad', 'missing', 'text',
             'diagnostics', 'status', 'reply', 'attachments', 'size', 'complete', 'createdAt'])
        && request.resource.data.kind in ['bug', 'idea', 'opinion']
        && request.resource.data.status == 'new'
        && request.resource.data.reply == ''
        && request.resource.data.complete == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.attachments is list
        && request.resource.data.attachments.size() <= 4
        && request.resource.data.size is int
        && request.resource.data.size <= 41943040
        && request.resource.data.good.size() <= 3000
        && request.resource.data.bad.size() <= 3000
        && request.resource.data.missing.size() <= 3000
        && request.resource.data.text.size() <= 3000
        && request.resource.data.diagnostics.size() <= 1000;
      allow update: if isAdmin()
        || (hasAccess() && isAuthor()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['complete'])
            && request.resource.data.complete == true);
      allow delete: if isAdmin() || (hasAccess() && isAuthor());

      match /chunks/{chunkId} {
        function parent() {
          return get(/databases/$(database)/documents/feedback/$(id)).data;
        }
        allow read: if isAdmin() || (hasAccess() && parent().uid == request.auth.uid);
        allow create: if hasAccess()
          && parent().uid == request.auth.uid
          && parent().complete == false
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 921600;
        allow delete: if isAdmin() || (hasAccess() && parent().uid == request.auth.uid);
      }
    }

    // Tytuły prowadzących (z publicznych stron USOSweb): czytają wszyscy z dostępem. Planer może
    // tylko zgłosić osobę do doczytania (pending) - tytuł wpisuje wyłącznie serwer przypomnień.
    match /people/{personId} {
      allow read: if hasAccess();
      allow create: if hasAccess()
        && personId.matches('^[0-9]{1,10}$')
        && request.resource.data.keys().hasOnly(['pending', 'requestedAt'])
        && request.resource.data.pending == true
        && request.resource.data.requestedAt == request.time;
    }

    // Wszystko inne (dziennik wysłanych przypomnień, zapamiętany plan do wykrywania zmian w USOS)
    // - niedostępne ze strony, korzysta z tego tylko serwer przypomnień.
  }
}
